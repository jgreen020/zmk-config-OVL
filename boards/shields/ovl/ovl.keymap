// This file was generated from a template. Edit it to match your keyboard.
// See https://zmk.dev/docs/development/hardware-integration/new-shield for more instructions.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    // Define a default keymap here.
    // See https://zmk.dev/docs/development/hardware-integration/new-shield#default-keymap.
keymap {
        compatible = "zmk,keymap";

        letters {
            bindings = <
            &none        &kp W  &kp E          &kp R               &kp T             &kp Y             &kp U      &kp I      &kp O    &kp DEL
            &lt 1 Q      &kp S  &kp D          &kp F               &kp G             &kp H             &kp J      &kp K      &kp L    &kp P
            &lt 3 A      &kp X  &kp C          &kp V               &kp B             &kp N             &kp M      &kp COMMA  &kp DOT  &lt 3 SEMI
            &mt RSHFT Z  &none  &mt LCTRL ESC  &mt LALT BACKSPACE  &mt LGUI SPACE    &mt LSHIFT SPACE  &lt 1 RET  &lt 2 TAB  &none  &mt RIGHT_SHIFT FSLH
            >;
        };

        numbers {
            bindings = <
            &trans      &none   &kp LPAR          &kp RPAR           &none     &kp N7  &kp N8  &kp N9    &kp MINUS  &trans
            &kp GRAVE   &none   &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &none     &kp N4  &kp N5  &kp N6    &kp APOS   &kp EQUAL
            &trans      &none   &kp LEFT_BRACE    &kp RIGHT_BRACE    &none     &kp N1  &kp N2  &kp N3    &kp DOT    &kp BSLH
            &kp RSHFT   &trans  &trans            &trans             &trans    &trans  &trans  &lt 2 N0  &trans     &kp RSHFT
            >;
        };

        symbols {
            bindings = <
            &trans               &kp INS  &kp HOME  &kp PG_UP  &kp PAUSE_BREAK    &kp AMPS         &kp STAR     &kp LPAR   &kp UNDER          &trans
            &kp TILDE            &kp DEL  &kp END   &kp PG_DN  &kp PRINTSCREEN    &kp DOLLAR       &kp PERCENT  &kp CARET  &kp DOUBLE_QUOTES  &kp PLUS
            &mt LSHIFT CAPSLOCK  &none    &none     &none      &none              &kp EXCLAMATION  &kp AT       &kp HASH   &kp DOT            &kp PIPE
            &trans               &trans   &trans    &trans     &trans             &trans           &trans       &trans     &trans             &kp RSHIFT
            >;
        };

        navigation {
            bindings = <
            &trans  &none     &kp UP    &kp TAB    &kp C_AC_DESKTOP_SHOW_ALL_WINDOWS         &kp C_AC_DESKTOP_SHOW_ALL_WINDOWS       &none     &kp UP    &none      &none
            &kp Q   &kp LEFT  &kp DOWN  &kp RIGHT  &kp ENTER                                 &kp C_AC_SEARCH                         &kp LEFT  &kp DOWN  &kp RIGHT  &trans
            &none   &kp X     &kp C     &kp V      &kp C_AC_DESKTOP_SHOW_ALL_APPLICATIONS    &kp C_AC_DESKTOP_SHOW_ALL_APPLICATIONS  &none     &none     &none      &none
            &trans  &trans    &trans    &trans     &trans                                    &trans                                  &trans    &trans    &trans     &trans
            >;
        };

        functions {
            bindings = <
            &trans  &kp F2   &kp F3   &kp F4   &bt BT_SEL 0    &bt BT_SEL 3  &kp C_VOL_UP  &kp C_NEXT  &kp C_BRI_UP  &trans
            &kp F1  &kp F6   &kp F7   &kp F8   &bt BT_SEL 1    &bt BT_SEL 4  &kp C_VOL_DN  &kp C_PP    &kp C_BRI_DN  &kp LA(LG(DELETE))
            &kp F5  &kp F10  &kp F11  &kp F12  &bt BT_SEL 2    &bt BT_CLR    &kp C_MUTE    &kp C_PREV  &kp C_PWR     &kp C_PIP
            &kp F9  &trans   &trans   &trans   &trans          &trans        &trans        &trans      &trans        &kp LC(LA(DELETE))
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        both {
            if-layers = <1 2>;
            then-layer = <4>;
        };
    };

    sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
};
